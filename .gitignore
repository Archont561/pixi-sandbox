docs/node_modules/
docs/dist/
docs/.astro/
# python scratch (the reference prototype is run directly, never imported)
__pycache__/
*.pyc
# coverage / reports
coverage/
lcov.info
*.profraw
# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

