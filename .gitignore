# --- generated / heavy: never commit ---------------------------------------
# pixi
.pixi/
# the transport payload (lives on the sandbox branch, not here)
# NB: keep this comment on its own line — git does not strip trailing comments,
# so `.pixi-sandbox/ # ...` would be parsed as a literal pattern and ignore nothing.
.pixi-sandbox/
# cargo config written by `pixi-sandbox restore` (points at the vendor tree)
/.cargo/
# rust
target/
# cargo vendoring (materialised by `pixi-sandbox restore`, never committed)
/vendor/
# docs
# bun hoists a workspace install to the root node_modules (see the root package.json),
# so this is not a docs-only path any more.
node_modules/
docs/dist/
docs/.astro/
# python scratch (the reference prototype is run directly, never imported)
__pycache__/
*.pyc
# coverage / reports
coverage/
lcov.info
*.profraw
# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# --- scratch / local runs --------------------------------------------------
/repro/
/repro*/
/.sandbox-out/
/.sandbox-transport/
/.sandbox-packages/
*.tar.zst
*.part[0-9][0-9][0-9]
!crates/pixi-sandbox/tests/fixtures/**/*.part[0-9][0-9][0-9]
# the transport fixture *is* committed branch content; without this negation git cannot re-include
# anything under an ignored directory, so a new fixture blob would be silently untrackable
!crates/pixi-sandbox/tests/fixtures/**/.pixi-sandbox/
# Written by prepare-release.sh so the release workflow can `git add` exactly what it changed
# instead of keeping its own list. It is a report about a release in progress, not a source file.
/.release-touched
